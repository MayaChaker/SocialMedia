PORT=4173
# Set this to a secure server endpoint that creates a hosted Stripe/Shopify checkout session.
# The endpoint should return either { "redirectUrl": "https://..." } or a confirmed order object.
REACT_APP_CHECKOUT_URL=
# Public customer-care address shown in the footer and policy pages.
REACT_APP_CONTACT_EMAIL=care@velourabeauty.com
# Optional subscription endpoint. It should accept { "email": "..." } as JSON.
REACT_APP_NEWSLETTER_URL=
